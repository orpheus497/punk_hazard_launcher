# ---------------------------------------------------------------------------
# punk_hazard_launcher -- ignored paths
#
# Rule of thumb: nothing that a build, a run, or an editor *generates* may
# ever enter the history.  Only hand-written source is tracked.
# ---------------------------------------------------------------------------

# Build products (POSIX suffix-rule output and the linked binary)
*.o
*.a
*.so
*.core
punkhazard

# bmake/gmake out-of-tree object directories
obj/
.objdir/
build/

# Dependency / compilation databases
.depend
.depend.*
compile_commands.json
*.d

# Debug and profiling droppings
*.dSYM/
*.gcda
*.gcno
*.gcov
gmon.out
vgcore.*
*.core.[0-9]*

# Local runtime data.  A developer commonly points PUNKHAZARD_ROOT at a
# scratch directory inside the checkout; never commit an installed library.
/root/
/games/
/var/
*.log

# Editor and OS noise
*~
*.sw[a-p]
.vscode/
.idea/
tags
TAGS
cscope.out
.DS_Store

# Generated by ./configure and by the font bake
/Makefile
/gen/
/tools/bin2c
/tools/phshot
/tools/embedtest
